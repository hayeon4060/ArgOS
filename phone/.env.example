# 예시 데이터 모드 (기본 true). 실제 연계 서버에 붙일 때 false
VITE_USE_MOCK=true

# 연계 서버 API 주소 (VITE_USE_MOCK=false 일 때)
# - 브라우저 개발(npm run dev): 비워 두면 /api/v1 → 개발 서버가 http://localhost:8080 으로 넘김
# - Android 앱(npm run android): 앱 안에서는 /api/v1 이 휴대폰 자신을 가리키므로 연계 서버 주소를 꼭 적음
#   예) VITE_API_BASE_URL=https://argos-gateway.example/api/v1   (http 주소면 Android 설정에서 cleartext 허용 필요)
VITE_API_BASE_URL=

# 설치형 앱(APK) 시연 빌드(예시 데이터 모드): PC 관제 웹 개발 서버 주소 — 예시 상황 · 알림을 PC 와 같이 씀
# 빌드(npm run android)에만 쓰이므로 .env.production.local 에 넣음 (브라우저 개발 npm run dev 는 그대로)
#   예) VITE_MOCK_RELAY=http://192.168.0.29:5173
# 비우면 앱 혼자 예시 데이터로 동작
