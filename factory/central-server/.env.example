FACTORY_SERVER_PORT=8081
FACTORY_DB_HOST=localhost
FACTORY_DB_PORT=5432
FACTORY_DB_NAME=argos_factory
FACTORY_DB_USERNAME=argos_factory
FACTORY_DB_PASSWORD=change-me

# 시연 시계 시작 시각 (서버가 켜진 순간 = 이 시각)
ARGOS_SIM_START=2026-11-16T09:00:00+09:00
# 서버 시작 때 7일치 더미데이터 가져오기 (이미 있으면 건너뜀)
ARGOS_HISTORY_IMPORT=true
ARGOS_HISTORY_PATH=../raw-data/dummy-data
ARGOS_HISTORY_RESET=false
# 개발·시연용 API (/api/v1/dev/**)
ARGOS_DEV_API=true
# 연계 서버 전용 API 키 (연계 서버의 CENTRAL_API_KEY 와 같은 값). 비우면 검사 안 함
ARGOS_INTERNAL_API_KEY=
# 센서 값(그래프용) 보관 기간: 시연 시계 기준 N일 지난 값을 1시간마다 삭제 (경보 이력은 보관)
ARGOS_RETENTION_ENABLED=true
ARGOS_RETENTION_DAYS=7
