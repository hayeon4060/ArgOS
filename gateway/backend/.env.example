GATEWAY_SERVER_PORT=8080
GATEWAY_DB_HOST=localhost
GATEWAY_DB_PORT=5433
GATEWAY_DB_NAME=argos_gateway
GATEWAY_DB_USERNAME=argos_gateway
GATEWAY_DB_PASSWORD=change-me
GATEWAY_JWT_SECRET_BASE64=replace-with-base64-of-at-least-32-random-bytes
GATEWAY_COOKIE_SECURE=false
GATEWAY_BOOTSTRAP_ADMIN_LOGIN=
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=

# 중앙 서버 연계
CENTRAL_SERVER_BASE_URL=http://localhost:8081
# 중앙 서버 ARGOS_INTERNAL_API_KEY 와 같은 값 (비우면 키 없이 호출)
CENTRAL_API_KEY=

# 파일 저장 위치 · CLOVA OCR · 보고서 글꼴 (비워도 동작)
ARGOS_FILES_DIR=./data/files
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
CLOVA_OCR_FORMS=F02
ARGOS_REPORT_FONT=
FCM_CREDENTIALS_PATH=
BROADCAST_API_URL=

# API 명세서(Swagger UI · /v3/api-docs). 운영에서 숨기려면 false
ARGOS_API_DOCS=true
