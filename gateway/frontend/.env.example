# 프론트엔드 환경변수 (변수명만 기록, 실제 값은 .env 에 넣고 커밋하지 않음)
# Vite 는 VITE_ 로 시작하는 변수만 화면 코드에 노출함

# [개발 서버 전용] /api 프록시가 요청을 보낼 백엔드 주소 (비우면 http://localhost:8080)
# 다른 PC의 서버에 붙을 때는 .env.local 에 VITE_PROXY_TARGET=http://<서버 IP>:8080 (커밋 안 됨)
VITE_PROXY_TARGET=
# 연계 서버 REST API 기본 주소 (비우면 '/api/v1' 사용. 다른 PC 주소를 넣으면 CORS 에 막히니 위 프록시를 씀)
VITE_API_BASE_URL=
# 실시간(SSE) 기본 주소 (비우면 VITE_API_BASE_URL 사용 예정)
VITE_WS_BASE_URL=
# 실행 모드: web(관제 웹) / app(Capacitor 모바일)
VITE_APP_MODE=web
# 예시 데이터 사용 여부 (백엔드 개발 전이라 기본 true, 실제 백엔드에 붙일 때 false)
VITE_USE_MOCK=true
# [개발 전용] 로그인 유지 시간을 분 단위로 짧게 (예: 2). 비우면 13시간. npm run dev 에서만 적용
VITE_DEV_SESSION_MINUTES=
